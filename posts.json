---
{% comment %} The index behind search and link cards. u url, t title, s subtitle, d date, w words, x opening words, b how many other posts link here. {% endcomment %}
[{% for post in site.posts %}{% assign back = 0 %}{% for other in site.posts %}{% if other.url != post.url and other.content contains post.url %}{% assign back = back | plus: 1 %}{% endif %}{% endfor %}{"u":{{ post.url | jsonify }},"t":{{ post.title | jsonify }},"s":{{ post.subtitle | default: "" | jsonify }},"d":"{{ post.date | date: "%Y-%m-%d" }}","w":{{ post.content | strip_html | number_of_words }},"x":{{ post.content | replace: "</p>", " " | strip_html | strip_newlines | truncatewords: 45 | jsonify }},"b":{{ back }}}{% unless forloop.last %},
{% endunless %}{% endfor %}]
