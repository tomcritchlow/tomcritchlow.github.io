---
{% comment %} The index behind search and link cards. u url, t title, s subtitle, d date, w words, x opening words, b how many other posts link here. {% endcomment %}
[{% for post in site.posts %}{% assign back = 0 %}{% for other in site.posts %}{% if other.url != post.url and other.content contains post.url %}{% assign back = back | plus: 1 %}{% endif %}{% endfor %}{% assign excerpt = post.content | replace: "</p>", " " | replace: "</h2>", " " | replace: "</h3>", " " | replace: "</h4>", " " | replace: "</blockquote>", " " | replace: "</li>", " " | replace: "<br>", " " | replace: "<br/>", " " | replace: "<br />", " " | strip_html | normalize_whitespace | replace: "&amp;", "&" | replace: "&#39;", "'" | replace: "&apos;", "'" | replace: "&quot;", '"' | replace: "&ldquo;", "“" | replace: "&rdquo;", "”" | replace: "&lsquo;", "‘" | replace: "&rsquo;", "’" | replace: "&mdash;", "—" | replace: "&ndash;", "–" | replace: "&hellip;", "…" | replace: "&nbsp;", " " | replace: "&lt;", "<" | replace: "&gt;", ">" | truncatewords: 45 %}{"u":{{ post.url | jsonify }},"t":{{ post.title | jsonify }},"s":{{ post.subtitle | default: "" | jsonify }},"d":"{{ post.date | date: "%Y-%m-%d" }}","w":{{ post.content | strip_html | number_of_words }},"x":{{ excerpt | jsonify }},"b":{{ back }}}{% unless forloop.last %},
{% endunless %}{% endfor %}]
